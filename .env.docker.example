## Example Docker Compose env file for local development.
## Copy to ".env" (or use --env-file) and fill as needed.
##
## IMPORTANT: Do not commit real tokens/keys.
CLAWDBOT_CONFIG_DIR=./.docker/clawdbot-config
CLAWDBOT_WORKSPACE_DIR=./.docker/clawdbot-workspace

# Gateway auth token (pick your own)
CLAWDBOT_GATEWAY_TOKEN=replace-me

# Optional: image + ports
CLAWDBOT_IMAGE=clawdbot:local
CLAWDBOT_GATEWAY_PORT=18789
CLAWDBOT_BRIDGE_PORT=18790

# Web search (Brave Search API)
BRAVE_API_KEY=replace-me

# Local LLM discovery (Ollama). Any non-empty value enables discovery.
OLLAMA_API_KEY=ollama-local

# OpenAI API key (required for openai audio transcription provider).
OPENAI_API_KEY=replace-me

# Google Workspace (gog) - Calendar/Drive/Gmail/etc.
# NOTE: this is NOT your Google password. It's used to encrypt the token store inside the container.
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=replace-me
GOG_ACCOUNT=you@gmail.com

# Optional: pin gogcli version used in the Docker image build.
GOGCLI_VERSION=0.9.0
