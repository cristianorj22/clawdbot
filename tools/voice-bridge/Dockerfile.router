FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.router.txt /app/requirements.router.txt
RUN pip install --no-cache-dir -r /app/requirements.router.txt

COPY voice_router /app/voice_router

EXPOSE 8787

CMD ["uvicorn", "voice_router.app:app", "--host", "0.0.0.0", "--port", "8787"]

